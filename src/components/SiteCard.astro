---
import type { SiteCard } from '../lib/og';

interface Props {
  card: SiteCard;
}

const { card } = Astro.props;
---

<li class="card">
  <a href={card.url}>
    <div class="media">
      {card.image && (
        <img
          src={card.image.src}
          alt={card.image.alt}
          width={card.image.width}
          height={card.image.height}
          loading="lazy"
          decoding="async"
        />
      )}
    </div>
    <div class="body">
      <span class="hostname">{card.hostname}</span>
      <h3>{card.title}</h3>
      {card.description && <p>{card.description}</p>}
    </div>
  </a>
</li>

<style>
  .card {
    list-style: none;
    border: 1px solid #505050;
    backdrop-filter: blur(8px);
    transition: border-color 150ms;
  }

  .card:hover,
  .card:focus-within {
    border-color: #00b4ff;
  }

  a {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
  }

  .media {
    aspect-ratio: 1200 / 630;
    background: linear-gradient(135deg, #623cc8, #171044);
    overflow: hidden;
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .body {
    padding: 1rem 1.25rem 1.25rem;
  }

  .hostname {
    font-size: 0.8em;
    color: #00b4ff;
  }

  h3 {
    margin: 0.25em 0 0;
    font-size: 1.25em;
    line-height: 1.2;
  }

  p {
    margin: 0.5em 0 0;
    font-size: 0.9em;
    line-height: 1.4;
    opacity: 0.8;
  }
</style>
