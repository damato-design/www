---
import type { SiteCard } from '../lib/og';

interface Props {
  card: SiteCard;
}

const { card } = Astro.props;
---

<li class="card">
  <a href={card.url}>
    <div class="media">
      {card.image && (
        <img
          src={card.image.src}
          alt={card.image.alt}
          width={card.image.width}
          height={card.image.height}
          loading="lazy"
          decoding="async"
        />
      )}
    </div>
    <div class="body">
      <span class="hostname">{card.hostname}</span>
      <h3>{card.title}</h3>
      {card.description && <p>{card.description}</p>}
    </div>
  </a>
</li>

<style>
  .card {
    list-style: none;
    border: 3px solid var(--navy);
    border-radius: 1.25rem;
    overflow: hidden;
    background: color-mix(in srgb, var(--cream) 85%, transparent);
    backdrop-filter: blur(8px);
    transition: box-shadow 150ms, translate 150ms;
  }

  .card:hover,
  .card:focus-within {
    box-shadow: var(--stripes-shadow);
    translate: -0.5rem -0.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
  }

  a {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
  }

  a:focus-visible {
    outline: none;
  }

  .media {
    aspect-ratio: 1200 / 630;
    border-bottom: 3px solid var(--navy);
    background: linear-gradient(
      var(--navy) 0 20%,
      var(--teal) 20% 40%,
      var(--mustard) 40% 60%,
      var(--orange) 60% 80%,
      var(--red) 80%
    );
    overflow: hidden;
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .body {
    padding: 1rem 1.25rem 1.25rem;
  }

  .hostname {
    font-size: 0.8em;
    font-weight: 700;
    color: var(--teal-dark);
  }

  h3 {
    margin: 0.25em 0 0;
    font-size: 1.35em;
    font-weight: 700;
    line-height: 1.2;
  }

  p {
    margin: 0.5em 0 0;
    font-size: 0.9em;
    line-height: 1.4;
    opacity: 0.85;
  }
</style>
