---
import Base from '../layouts/Base.astro';
import SiteCard from '../components/SiteCard.astro';
import { getCollection } from 'astro:content';
import { getSiteCards } from '../lib/og';

const sites = (await getCollection('sites')).sort((a, b) => a.data.order - b.data.order);
const cards = await getSiteCards(sites.map(({ data }) => data));
const description = "The home of Donnie & Jennifer (Ip) D'Amato, who both practice in the field of design systems professionally.";
---

<Base description={description}>
  <main id="main">
    <header>
      <h1>damato<wbr />.design</h1>
      <h2>Where design <strong>stops being polite</strong>
      <br />and <strong>starts getting usable</strong></h2>
    </header>
  </main>
  {cards.length > 0 && (
    <ul class="sites" aria-label="damato.design sites">
      {cards.map((card) => <SiteCard card={card} />)}
    </ul>
  )}
</Base>
